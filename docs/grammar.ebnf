(* JAHE designed syntax grammar. This is a design reference, not the compiler-0.7 parser grammar. *)

compilation-unit = [ module-declaration ], { import-declaration }, { item } ;
module-declaration = "module", module-path, ";" ;
import-declaration = "import", module-path, [ "as", identifier ], ";" ;
module-path = identifier, { ".", identifier } ;

item = [ visibility ], ( function-declaration | external-function | constant-declaration
      | struct-declaration | enum-declaration | trait-declaration | impl-declaration ) ;
visibility = "pub" ;
function-declaration = [ "unsafe" ], "func", identifier, [ generic-parameters ],
                       "(", [ parameter-list ], ")", [ "->", type ], block ;
external-function = "extern", string-literal, [ "unsafe" ], "func", identifier,
                    [ generic-parameters ], "(", [ parameter-list ], ")",
                    [ "->", type ], ";" ;
parameter-list = parameter, { ",", parameter }, [ "," ] ;
parameter = receiver | identifier, ":", type ;
receiver = "self" | "&", [ "mut" ], "self" ;
generic-parameters = "<", generic-parameter, { ",", generic-parameter }, [ "," ], ">" ;
generic-parameter = identifier, [ ":", type-path, { "+", type-path } ] ;

constant-declaration = "const", identifier, ":", type, "=", expression, ";" ;
struct-declaration = "struct", identifier, [ generic-parameters ], "{",
                     [ field, { ",", field }, [ "," ] ], "}" ;
field = [ visibility ], identifier, ":", type ;
enum-declaration = "enum", identifier, [ generic-parameters ], "{",
                   [ variant, { ",", variant }, [ "," ] ], "}" ;
variant = identifier, [ "(", type-list, ")" | "{", [ field, { ",", field }, [ "," ] ], "}" ] ;
trait-declaration = "trait", identifier, [ generic-parameters ], [ ":", type-path, { "+", type-path } ],
                    "{", { [ "pub" ], function-signature, ( ";" | block ) }, "}" ;
impl-declaration = "impl", [ generic-parameters ], type, [ "for", type ],
                   "{", { [ visibility ], function-declaration }, "}" ;
function-signature = [ "unsafe" ], "func", identifier, [ generic-parameters ],
                     "(", [ parameter-list ], ")", [ "->", type ] ;

type-list = type, { ",", type }, [ "," ] ;
type = "void" | "never" | type-path | "&", [ "mut" ], type
     | "*const", type | "*mut", type
     | "[", type, ";", integer-literal, "]"
     | "[", type, "]"
     | "(", type-list, [ "," ], ")"
     | "func", "(", [ type-list ], ")", "->", type
     | type-path, "<", type-list, ">" ;
type-path = identifier, { ( "::" | "." ), identifier } ;

block = "{", { statement }, "}" ;
statement = local-declaration | constant-declaration | return-statement | if-statement
          | while-statement | for-statement | loop-statement | match-statement
          | break-statement | continue-statement | unsafe-block | block
          | assignment-statement | expression, ";" ;
local-declaration = ( "let" | "var" ), identifier, [ ":", type ], "=", expression, ";" ;
return-statement = "return", [ expression ], ";" ;
if-statement = "if", expression, block, [ "else", ( block | if-statement ) ] ;
while-statement = "while", expression, block ;
for-statement = "for", pattern, "in", expression, block ;
loop-statement = "loop", block ;
break-statement = "break", [ identifier ], ";" ;
continue-statement = "continue", [ identifier ], ";" ;
unsafe-block = "unsafe", block ;
assignment-statement = place, assignment-operator, expression, ";" ;
assignment-operator = "=" | "+=" | "-=" | "*=" | "/=" ;
place = identifier, { ".", identifier | "[", expression, "]" } ;

match-statement = "match", expression, "{", [ match-arm, { ",", match-arm }, [ "," ] ], "}" ;
match-arm = pattern, [ "if", expression ], "=>", ( expression | block ) ;
pattern = pattern-range, { "|", pattern-range } ;
pattern-range = pattern-atom, [ "..", pattern-atom ] ;
pattern-atom = "_" | literal | identifier | type-path, [ "(", pattern-list, ")"
             | "{", [ field-pattern, { ",", field-pattern }, [ "," ] ], "}" ]
             | "(", pattern-list, ")" ;
field-pattern = [ identifier, ":" ], pattern ;
pattern-list = pattern, { ",", pattern }, [ "," ] ;

expression = logical-or ;
logical-or = logical-and, { "||", logical-and } ;
logical-and = equality, { "&&", equality } ;
equality = comparison, [ ( "==" | "!=" ), comparison ] ;
comparison = range-expression, [ ( "<" | "<=" | ">" | ">=" ), range-expression ] ;
range-expression = bit-or, [ ( ".." | "..=" ), bit-or ] ;
bit-or = bit-xor, { "|", bit-xor } ;
bit-xor = bit-and, { "^", bit-and } ;
bit-and = shift, { "&", shift } ;
shift = additive, { ( "<<" | ">>" ), additive } ;
additive = multiplicative, { ( "+" | "-" ), multiplicative } ;
multiplicative = unary, { ( "*" | "/" | "%" ), unary } ;
unary = { unary-operator }, postfix ;
unary-operator = "!" | "-" | "~" | "&", [ "mut" ] | "*" | "unsafe" ;
postfix = primary, { call-suffix | index-suffix | member-suffix | "?" | cast-suffix } ;
call-suffix = "(", [ argument-list ], ")" ;
argument-list = expression, { ",", expression }, [ "," ] ;
index-suffix = "[", expression, "]" ;
member-suffix = ( "." | "::" ), identifier ;
cast-suffix = "as", type ;
primary = literal | identifier | "(", [ expression-list ], ")"
        | array-literal | struct-literal | match-expression | block ;
expression-list = expression, { ",", expression }, [ "," ] ;
array-literal = "[", [ expression-list ], "]" ;
struct-literal = type-path, "{", [ field-initializer, { ",", field-initializer }, [ "," ] ], "}" ;
field-initializer = identifier, ":", expression ;
match-expression = "match", expression, "{", [ match-arm, { ",", match-arm }, [ "," ] ], "}" ;

literal = integer-literal | float-literal | string-literal | character-literal | "true" | "false" ;
identifier = letter-or-underscore, { letter-or-underscore | digit } ;
integer-literal = digit, { digit | "_" } ;
float-literal = digit, { digit | "_" }, ".", digit, { digit | "_" } ;
string-literal = '"', { string-character | escape }, '"' ;
character-literal = "'", ( string-character | escape ), "'" ;
escape = "\\", ( "n" | "r" | "t" | "0" | "\\" | "'" | '"' | "u{", hex-digit, { hex-digit }, "}" ) ;
(* Whitespace and // line comments may occur between tokens. Literal decoding is UTF-8. A character-literal contains exactly one Unicode scalar. *)
(* Lexical classes letter-or-underscore, digit, hex-digit, string-character are conventional. *)
