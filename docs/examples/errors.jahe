// Designed syntax only; Result and match are deferred.
module errors_demo;
import std.fs as fs;
import std.io as io;
import std.core as core;
import std.string as strings;

func read_config(path: str) -> core.Result<strings.String, fs.Error> {
    return fs.read_to_string(path);
}

func use_config(value: strings.String) {
    io.println(value);
}

func ignore_config(path: str) {
    // Explicitly discard a must-use Result when the caller intentionally ignores it.
    let _ = read_config(path);
}

func main() -> i32 {
    match read_config("app.conf") {
        core.Result.Ok(text) => { use_config(text); return 0; },
        core.Result.Err(error) => { io.println(error); return 1; },
    }
}
